{
    "name": "letsemploy/typo3-ojobpub",
    "type": "typo3-cms-extension",
    "description": "Publishes a site's job openings as an oJobPub 1.0 feed at /.well-known/ojobpub.json.",
    "keywords": ["TYPO3", "extension", "jobs", "oJobPub", "well-known", "letsemploy"],
    "homepage": "https://docs.letsemploy.org",
    "license": "GPL-2.0-or-later",
    "authors": [
        {
            "name": "Let's Employ",
            "homepage": "https://letsemploy.org"
        }
    ],
    "support": {
        "issues": "https://github.com/letsemploy/typo3-ojobpub/issues",
        "source": "https://github.com/letsemploy/typo3-ojobpub",
        "docs": "https://docs.letsemploy.org"
    },
    "require": {
        "php": "^8.2",
        "typo3/cms-core": "^13.4 || ^14.3",
        "typo3/cms-frontend": "^13.4 || ^14.3"
    },
    "require-dev": {
        "opis/json-schema": "^2.6",
        "phpunit/phpunit": "^11.5.57 || ^12.5.40 || ^13.4.3",
        "typo3/testing-framework": "^9.5"
    },
    "autoload": {
        "psr-4": {
            "LetsEmploy\\OJobPub\\": "Classes/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "LetsEmploy\\OJobPub\\Tests\\": "Tests/"
        }
    },
    "extra": {
        "typo3/cms": {
            "extension-key": "ojobpub",
            "version": "0.1.0-alpha",
            "Package": {
                "providesPackages": {}
            }
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "typo3/class-alias-loader": true,
            "typo3/cms-composer-installers": true
        }
    }
}
